# ---------------------------------------------------------------------------
# Multiplayer server configuration
# ---------------------------------------------------------------------------
# Every value here is validated at startup; the process refuses to boot on bad
# input rather than failing at the first request.

# development | production | test
NODE_ENV=development

PORT=3001

# Comma-separated EXACT origins allowed to reach the API and the socket.
# REQUIRED in production - the server will not start without it.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Comma-separated regex patterns for preview deployments.
# Ignored in production, deliberately: a wildcard like \.vercel\.app$ would let
# any subdomain anyone can register talk to the game server.
# ALLOWED_ORIGIN_PATTERNS=^https://web3-farming-game-.*\.vercel\.app$

# debug | info | warn | error
LOG_LEVEL=debug

# Set true when running behind a load balancer so client IPs (and therefore
# rate limits) are read from X-Forwarded-For. Defaults to true in production.
TRUST_PROXY=false

# Chain the game targets. Informational; the server never signs transactions.
CHAIN_ID=11155111

MAX_HTTP_BODY_BYTES=16384

# NOTE: this service holds no private keys and signs nothing. It verifies
# signatures produced by players' wallets, and that is all.
