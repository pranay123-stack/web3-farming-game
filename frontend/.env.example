# ---------------------------------------------------------------------------
# Frontend configuration
# ---------------------------------------------------------------------------
# Copy to .env.local for development. Everything here is NEXT_PUBLIC_ and ships
# to the browser, so never put a secret in this file.

# Chain the app targets. Must match a deployment recorded in deployments/.
#   11155111  Sepolia
#   31337     local Hardhat node
NEXT_PUBLIC_CHAIN_ID=11155111

# Override the read-only RPC endpoint. Leave unset to use the public default
# for the chain. A dedicated endpoint (Alchemy, Infura, dRPC) is strongly
# recommended for anything beyond local development — public endpoints rate
# limit aggressively and the game reads on every refresh.
# NEXT_PUBLIC_RPC_URL=

# Multiplayer server. Presence and chat only; it holds no game state.
NEXT_PUBLIC_MULTIPLAYER_URL=http://localhost:3001

# Set to "false" to run the game single-player with no socket connection.
NEXT_PUBLIC_MULTIPLAYER_ENABLED=true
